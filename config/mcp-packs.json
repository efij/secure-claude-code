{
  "postgres": {
    "sql_policy": {
      "enabled": true,
      "mode": "readonly",
      "tool_names": ["query", "execute_sql", "run_sql", "run_sql_transaction"],
      "sql_arg_candidates": ["sql", "query", "statement"]
    },
    "context": {
      "inject_into": ["query", "execute_sql", "run_sql", "run_sql_transaction"],
      "position": "append",
      "label": "Runwall Schema Context"
    }
  },
  "github": {
    "context": {
      "inject_into": ["search_*", "list_*", "get_*", "fetch_*"],
      "position": "append",
      "label": "Runwall Repo Context"
    }
  },
  "filesystem": {
    "context": {
      "inject_into": ["*"],
      "position": "append",
      "label": "Runwall Workspace Context"
    }
  },
  "stripe": {
    "context": {
      "inject_into": ["*"],
      "position": "append",
      "label": "Runwall Account Context"
    }
  },
  "linear": {
    "context": {
      "inject_into": ["*"],
      "position": "append",
      "label": "Runwall Workspace Context"
    }
  },
  "supabase": {
    "sql_policy": {
      "enabled": true,
      "mode": "readonly",
      "tool_names": ["execute_sql", "run_sql", "run_sql_transaction", "query"],
      "sql_arg_candidates": ["sql", "query", "statement"]
    },
    "context": {
      "inject_into": ["execute_sql", "run_sql", "run_sql_transaction", "query"],
      "position": "append",
      "label": "Runwall Schema Context"
    }
  }
}
