{
  "id": "git-submodule-source-swap-guard",
  "name": "Git Submodule Source Swap Guard Pack",
  "description": "Prompts when git submodule URLs move to unreviewed hosts or raw sources.",
  "category": "git",
  "kind": "prompt",
  "default_profiles": [
    "balanced",
    "strict"
  ],
  "rules": [
    "security-baseline.md",
    "change-safety.md"
  ],
  "hook": {
    "event": "PreToolUse",
    "matcher": "Write|Edit|MultiEdit|Bash",
    "type": "command",
    "command": "bash ~/.stallion/hooks/git-submodule-source-swap-guard.sh \"$TOOL_INPUT\""
  },
  "family": "Git & Source Control"
}
