{
  "id": "terraform-provider-source-swap-guard",
  "name": "Terraform Provider Source Swap Guard Pack",
  "description": "Prompts when Terraform or OpenTofu provider sources move to unreviewed registries or namespaces.",
  "category": "supply-chain",
  "kind": "prompt",
  "default_profiles": [
    "balanced",
    "strict"
  ],
  "rules": [
    "security-baseline.md",
    "change-safety.md"
  ],
  "hook": {
    "event": "PreToolUse",
    "matcher": "Write|Edit|MultiEdit|Bash",
    "type": "command",
    "command": "bash ~/.runwall/hooks/terraform-provider-source-swap-guard.sh \"$TOOL_INPUT\""
  },
  "family": "Supply Chain & Dependencies"
}
