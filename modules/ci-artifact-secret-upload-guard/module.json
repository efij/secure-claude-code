{
  "id": "ci-artifact-secret-upload-guard",
  "name": "CI Artifact Secret Upload Guard Pack",
  "description": "Blocks CI artifact uploads and release bundles that include secret-bearing files.",
  "category": "supply-chain",
  "kind": "block",
  "default_profiles": [
    "balanced",
    "strict"
  ],
  "rules": [
    "security-baseline.md",
    "change-safety.md"
  ],
  "hook": {
    "event": "PreToolUse",
    "matcher": "Write|Edit|MultiEdit|Bash",
    "type": "command",
    "command": "bash ~/.runwall/hooks/ci-artifact-secret-upload-guard.sh \"$TOOL_INPUT\""
  },
  "family": "Supply Chain & Dependencies"
}
