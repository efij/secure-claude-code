{
  "id": "git-attributes-filter-guard",
  "name": "Git Attributes Filter Guard Pack",
  "description": "Blocks filter, smudge, and clean hooks injected through git attributes or git config.",
  "category": "git",
  "kind": "block",
  "default_profiles": [
    "balanced",
    "strict"
  ],
  "rules": [
    "security-baseline.md",
    "change-safety.md"
  ],
  "hook": {
    "event": "PreToolUse",
    "matcher": "Write|Edit|MultiEdit|Bash",
    "type": "command",
    "command": "bash ~/.runwall/hooks/git-attributes-filter-guard.sh \"$TOOL_INPUT\""
  },
  "family": "Git & Source Control"
}
