# GitHub Actions snippet for Stallion CI mode
- name: Stallion policy validation
  run: |
    python3 scripts/validate-patterns.py config
    ./bin/stallion validate

# Example policy gate for high-risk generated commands:
- name: Stallion gate deploy command
  env:
    STALLION_COMMAND: "kubectl --context prod apply -f deploy.yaml"
  run: |
    ./bin/stallion evaluate PreToolUse Bash "$STALLION_COMMAND" --profile strict --json
